# Mẫu: copy thành .env rồi điền giá trị. providers.py tự nạp .env (env_file_loader.py).
# Ưu tiên: giá trị trong .env ghi đè biến terminal; dòng thiếu/để trống/placeholder YOUR_... thì dùng biến terminal.
# KHÔNG commit .env (đã có trong .gitignore).
export PROVIDER=openrouter
export MODEL=deepseek/deepseek-v4.1-flash-1017
export OPENROUTER_API_KEY=YOUR_KEY
# export GEMINI_API_KEY=YOUR_KEY
# export ANTHROPIC_API_KEY=YOUR_KEY
# export OPENROUTER_API_KEY=YOUR_KEY
